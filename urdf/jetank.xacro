<?xml version="1.0"?>
<robot name="jetank" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find jetank_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find jetank_description)/urdf/jetank_wheel.xacro"/>
  <xacro:include filename="$(find jetank_description)/urdf/jetank_arm.xacro"/>
  <xacro:include filename="$(find jetank_description)/urdf/jetank_gripper.xacro"/>
  <xacro:include filename="$(find jetank_description)/urdf/jetank_camera.xacro"/>

  <!-- RPLidar arguments (optional hardware LiDAR) -->
  <xacro:arg name="use_rplidar" default="false"/>
  <xacro:arg name="rplidar_x" default="0.0"/>
  <xacro:arg name="rplidar_y" default="0.0"/>
  <xacro:arg name="rplidar_z" default="0.05"/>  <!-- Above chassis top -->
  

  <!-- Base link -->
  <link name="base_link" />

  <!-- Main robot frame -->
  <link name="chassis">
    <visual>
      <!-- <origin xyz="0 0 ${ground_clearance+(chassis_height/2)}" /> -->
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </visual>
    <collision>
      <!-- <origin xyz="0.0 0.0 ${(ground_clearance+(chassis_height/2))}"/> -->
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>



  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0.0 0.0 ${(ground_clearance+(chassis_height/2))}"/>
  </joint>

      <!-- Instantiate wheels -->
  <xacro:wheel prefix="left_front" x="${((chassis_length/2)-(0.02+wheel_radius))}" y="${-((chassis_width / 2)+(wheel_length/2))}" z="${-wheel_radius}"/>
  <xacro:wheel prefix="right_front" x="${((chassis_length/2)-(0.02+wheel_radius))}" y="${((chassis_width / 2)+(wheel_length/2))}" z="${-wheel_radius}"/>

  <xacro:wheel prefix="left_middle" x="0" y="${-((chassis_width / 2)+(wheel_length/2))}" z="${-wheel_radius}"/>
  <xacro:wheel prefix="right_middle" x="0" y="${((chassis_width / 2)+(wheel_length/2))}" z="${-wheel_radius}"/>

  <xacro:wheel prefix="left_back" x="${-((chassis_length/2)-(0.02+wheel_radius))}" y="${-((chassis_width / 2)+(wheel_length/2))}" z="${-wheel_radius}"/>
  <xacro:wheel prefix="right_back" x="${-((chassis_length/2)-(0.02+wheel_radius))}" y="${((chassis_width / 2)+(wheel_length/2))}" z="${-wheel_radius}"/>

  <!-- Conditional RPLidar (hardware LiDAR) -->
  <xacro:if value="$(arg use_rplidar)">
    <xacro:include filename="$(find jetank_description)/urdf/components/lidar.xacro"/>
    <xacro:rplidar parent="chassis"
                   x="$(arg rplidar_x)"
                   y="$(arg rplidar_y)"
                   z="$(arg rplidar_z)"/>
  </xacro:if>

</robot>