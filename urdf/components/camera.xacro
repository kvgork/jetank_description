<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- JeTank Camera Mount -->

  <material name="camera_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <xacro:macro name="jetank_camera" params="parent">

    <!-- Camera mount joint -->
    <joint name="camera_joint" type="fixed">
      <origin xyz="0.0125 0 -0.0275" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="camera_link"/>
    </joint>

    <link name="camera_link">
      <visual>
        <origin xyz="0.0225 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.055 0.025"/>
        </geometry>
        <material name="camera_black"/>
      </visual>
      <collision>
        <origin xyz="0.0225 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.055 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0"
                 iyy="0.00001" iyz="0"
                 izz="0.00001"/>
      </inertial>
    </link>

    <!-- Camera BODY frames (REP-103: +X forward). Ignition's camera looks along
         the +X of the frame the <sensor> is attached to, so the gz sensors mount
         here to look forward. -->
    <joint name="camera_left_joint" type="fixed">
      <origin xyz="0.045 0.03 0" rpy="0 0 0"/>
      <parent link="camera_link"/>
      <child link="camera_left_link"/>
    </joint>
    <link name="camera_left_link"/>

    <joint name="camera_right_joint" type="fixed">
      <origin xyz="0.045 -0.03 0" rpy="0 0 0"/>
      <parent link="camera_link"/>
      <child link="camera_right_link"/>
    </joint>
    <link name="camera_right_link"/>

    <!-- True OPTICAL frames (REP-103: +Z forward, +X right, +Y down). These are
         the frame_id for images / disparity / point clouds, so OpenCV's
         reprojectImageTo3D output (z-forward) is correctly oriented. -->
    <joint name="camera_left_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      <parent link="camera_left_link"/>
      <child link="camera_left_optical_frame"/>
    </joint>
    <link name="camera_left_optical_frame"/>

    <joint name="camera_right_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      <parent link="camera_right_link"/>
      <child link="camera_right_optical_frame"/>
    </joint>
    <link name="camera_right_optical_frame"/>

    <!-- Gazebo color -->
    <gazebo reference="camera_link">
      <material>Gazebo/Black</material>
    </gazebo>

    <!-- Gazebo Stereo Camera Sensors (simulation only) -->
    <!-- Matches IMX219-83 hardware: 640×360, 30fps, 73° FOV, 60mm baseline -->

    <!-- LEFT CAMERA — sensor on the body frame (looks +X forward); images tagged
         with the optical frame via ignition_frame_id. -->
    <gazebo reference="camera_left_link">
      <sensor name="stereo_camera_left" type="camera">
        <topic>stereo_camera/left/image_raw</topic>
        <ignition_frame_id>camera_left_optical_frame</ignition_frame_id>
        <update_rate>30.0</update_rate>
        <camera name="left">
          <horizontal_fov>1.274</horizontal_fov>  <!-- 73° in radians -->
          <image>
            <width>640</width>
            <height>360</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>  <!-- Realistic sensor noise -->
          </noise>
          <lens>
            <type>custom</type>
            <custom_function>
              <c1>1.05</c1>
              <c2>4</c2>
              <f>1.0</f>
              <fun>tan</fun>
            </custom_function>
            <scale_to_hfov>true</scale_to_hfov>
          </lens>
        </camera>
        <!-- Camera plugin removed - using ros_gz_bridge in launch file instead -->
      </sensor>
    </gazebo>

    <!-- RIGHT CAMERA — sensor on the body frame (looks +X forward); images tagged
         with the optical frame via ignition_frame_id. -->
    <gazebo reference="camera_right_link">
      <sensor name="stereo_camera_right" type="camera">
        <topic>stereo_camera/right/image_raw</topic>
        <ignition_frame_id>camera_right_optical_frame</ignition_frame_id>
        <update_rate>30.0</update_rate>
        <camera name="right">
          <horizontal_fov>1.274</horizontal_fov>  <!-- 73° in radians -->
          <image>
            <width>640</width>
            <height>360</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>  <!-- Realistic sensor noise -->
          </noise>
          <lens>
            <type>custom</type>
            <custom_function>
              <c1>1.05</c1>
              <c2>4</c2>
              <f>1.0</f>
              <fun>tan</fun>
            </custom_function>
            <scale_to_hfov>true</scale_to_hfov>
          </lens>
        </camera>
        <!-- Camera plugin removed - using ros_gz_bridge in launch file instead -->
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
