<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ICM-20948 IMU sensor component.
    This IMU is integrated into the Waveshare IMX219-83 Stereo Camera module,
    providing 9-axis (accelerometer, gyroscope, magnetometer) motion sensing.
    It is physically co-located with the stereo camera on the robot arm.
  -->

  <xacro:macro name="imu_sensor" params="parent x y z">

    <link name="imu_link">
      <visual>
        <geometry>
          <!-- Small box representing the ICM-20948 IMU chip (3mm x 3mm x 1mm) -->
          <box size="0.003 0.003 0.001"/>
        </geometry>
        <material name="imu_green">
          <color rgba="0.1 0.6 0.1 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.003"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
                 iyy="1e-6" iyz="0.0"
                 izz="1e-6"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo (Ignition Fortress) IMU sensor. Real hardware ignores <gazebo>
         tags. Requires the Imu system to be loaded in the world. -->
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <topic>imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
