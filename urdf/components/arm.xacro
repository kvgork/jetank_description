<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- JeTank Arm - 5 DOF based on existing structure -->

  <material name="arm_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="arm_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="jetank_arm" params="parent">

    <!-- Arm bearing (base rotation) -->
    <joint name="arm_bearing_joint" type="fixed">
      <origin xyz="0.045 0 0.045" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="arm_bearing_link"/>
    </joint>

    <link name="arm_bearing_link">
      <visual>
        <geometry>
          <cylinder radius="0.02" length="0.01"/>
        </geometry>
        <material name="arm_grey"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.01"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.05" r="0.02" l="0.01"/>
    </link>

    <!-- S1 Joint - Base rotation (maps to Servo ID 1) -->
    <joint name="S1_joint" type="revolute">
      <origin xyz="0.0025 0 0.0425" rpy="0 0 0"/>
      <parent link="arm_bearing_link"/>
      <child link="S1_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.35" upper="2.35" effort="1.0" velocity="1.57"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="S1_link">
      <visual>
        <geometry>
          <box size="0.045 0.045 0.075"/>
        </geometry>
        <material name="arm_blue"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.045 0.045 0.075"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.05" x="0.045" y="0.045" z="0.075"/>
    </link>

    <!-- S2 Joint - Shoulder pitch (maps to Servo ID 2) -->
    <joint name="S2_joint" type="revolute">
      <origin xyz="0.0075 0 0.0275" rpy="0 -1.5708 0"/>
      <parent link="S1_link"/>
      <child link="S2_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.57"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="S2_link">
      <visual>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.12 0.055 0.025"/>
        </geometry>
        <material name="arm_grey"/>
      </visual>
      <collision>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.12 0.055 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.06 0 0"/>
        <mass value="0.04"/>
        <inertia ixx="0.00001" ixy="0" ixz="0"
                 iyy="0.00005" iyz="0"
                 izz="0.00005"/>
      </inertial>
    </link>

    <!-- S3 Joint - Elbow pitch (maps to Servo ID 3) -->
    <joint name="S3_joint" type="revolute">
      <origin xyz="0.11 0 0" rpy="0 1.5708 0"/>
      <parent link="S2_link"/>
      <child link="S3_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.57"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="S3_link">
      <visual>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.09 0.045 0.02"/>
        </geometry>
        <material name="arm_blue"/>
      </visual>
      <collision>
        <origin xyz="0.06 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.09 0.045 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.06 0 0"/>
        <mass value="0.03"/>
        <inertia ixx="0.000005" ixy="0" ixz="0"
                 iyy="0.00002" iyz="0"
                 izz="0.00002"/>
      </inertial>
    </link>

    <!-- S4 Joint - Wrist pitch. FIXED: Servo ID 4 is repurposed to drive the
         gripper, so the wrist pitch is not actuated. Modelling it as fixed
         keeps the 'arm' planning chain a clean 4-DOF (S1, S2, S3, S5) group
         that matches ros2_control, the arm_controller, and the SRDF poses. -->
    <joint name="S4_joint" type="fixed">
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <parent link="S3_link"/>
      <child link="S4_link"/>
    </joint>

    <link name="S4_link">
      <visual>
        <geometry>
          <box size="0.02 0.02 0.03"/>
        </geometry>
        <material name="arm_grey"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.02 0.02 0.03"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.02" x="0.02" y="0.02" z="0.03"/>
    </link>

    <!-- S5 Joint - Wrist roll (maps to Servo ID 5) -->
    <joint name="S5_joint" type="revolute">
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <parent link="S4_link"/>
      <child link="S5_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="0.3" velocity="1.57"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="S5_link">
      <visual>
        <geometry>
          <cylinder radius="0.015" length="0.02"/>
        </geometry>
        <material name="arm_blue"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.015" length="0.02"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.01" r="0.015" l="0.02"/>
    </link>

    <!-- Gazebo colors -->
    <gazebo reference="arm_bearing_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="S1_link">
      <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="S2_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="S3_link">
      <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="S4_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="S5_link">
      <material>Gazebo/Blue</material>
    </gazebo>

  </xacro:macro>

</robot>
