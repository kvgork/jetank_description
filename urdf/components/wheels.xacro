<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- JeTank Wheels - Track system represented as wheels -->

  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <xacro:property name="wheel_radius" value="0.03"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.1"/>

  <xacro:macro name="wheel_inertia" params="m r w">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+w*w)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+w*w)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="name parent x y">
    <joint name="${name}_joint" type="continuous">
      <origin xyz="${x} ${y} ${-wheel_radius}" rpy="-1.5708 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
    </link>

    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="jetank_wheels" params="parent">
    <xacro:wheel name="front_left_wheel" parent="${parent}" x="0.05" y="0.07"/>
    <xacro:wheel name="front_right_wheel" parent="${parent}" x="0.05" y="-0.07"/>
    <xacro:wheel name="rear_left_wheel" parent="${parent}" x="-0.05" y="0.07"/>
    <xacro:wheel name="rear_right_wheel" parent="${parent}" x="-0.05" y="-0.07"/>
  </xacro:macro>

</robot>
