<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- JeTank Gripper - Parallel jaw gripper -->

  <material name="gripper_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <xacro:macro name="jetank_gripper" params="parent">

    <!-- Gripper base -->
    <joint name="gripper_base_joint" type="fixed">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
    </joint>

    <link name="gripper_base_link">
      <visual>
        <geometry>
          <box size="0.04 0.08 0.06"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.08 0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>
    </link>

    <!-- Left finger -->
    <joint name="gripper_left_joint" type="prismatic">
      <origin xyz="0 0.04 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_left_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="0.5" velocity="0.1"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <link name="gripper_left_link">
      <visual>
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.03 0.04"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0.015 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.03 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0.015 0"/>
        <inertia ixx="0.0000005" ixy="0" ixz="0"
                 iyy="0.0000005" iyz="0"
                 izz="0.0000005"/>
      </inertial>
    </link>

    <!-- Right finger (mirrored) -->
    <joint name="gripper_right_joint" type="prismatic">
      <origin xyz="0 -0.04 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_right_link"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="0.5" velocity="0.1"/>
      <dynamics damping="0.1" friction="0.05"/>
      <mimic joint="gripper_left_joint" multiplier="1.0" offset="0"/>
    </joint>

    <link name="gripper_right_link">
      <visual>
        <origin xyz="0 -0.015 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.03 0.04"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <origin xyz="0 -0.015 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.03 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 -0.015 0"/>
        <inertia ixx="0.0000005" ixy="0" ixz="0"
                 iyy="0.0000005" iyz="0"
                 izz="0.0000005"/>
      </inertial>
    </link>

    <!-- Gazebo properties -->
    <gazebo reference="gripper_base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="gripper_left_link">
      <material>Gazebo/DarkGrey</material>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="gripper_right_link">
      <material>Gazebo/DarkGrey</material>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

  </xacro:macro>

</robot>
