<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- JeTank Gripper - Parallel jaw gripper -->

  <material name="gripper_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <xacro:macro name="jetank_gripper" params="parent">

    <!-- Gripper base -->
    <joint name="gripper_base_joint" type="fixed">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
    </joint>

    <link name="gripper_base_link">
      <visual>
        <geometry>
          <box size="0.04 0.08 0.06"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.08 0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>
    </link>

    <!-- Left finger -->
    <joint name="gripper_left_joint" type="prismatic">
      <origin xyz="0 0.04 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_left_link"/>
      <axis xyz="0 1 0"/>
      <!-- effort raised to 5 N (was 0.5) so GripperActionController can overcome
           damping without stalling -->
      <limit lower="0.0" upper="0.04" effort="5.0" velocity="0.5"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <link name="gripper_left_link">
      <visual>
        <origin xyz="0.04 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <box size="0.04 0.01 0.03"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <origin xyz="0.04 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <box size="0.04 0.01 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0.04 0 0"/>
        <inertia ixx="0.0000005" ixy="0" ixz="0"
                 iyy="0.0000005" iyz="0"
                 izz="0.0000005"/>
      </inertial>
    </link>

    <!-- Right finger (mirrored).
         URDF <mimic> tag RESTORED: robot_state_publisher reads this to compute
         gripper_right_link TF and MoveIt needs the real URDF joint model.
         The ros2_control native mimic params (<param name="mimic">) are REMOVED
         from ros2_control.xacro because gz_ros2_control appends "_mimic" to the
         published state interface name, producing "gripper_right_joint_mimic" in
         /joint_states instead of the real URDF name "gripper_right_joint".

         Physics: Gazebo Fortress may or may not enforce the URDF <mimic>
         constraint. If it does (with effort=5 N this is plausible), both fingers
         move together. If not, the right finger stays at 0 in physics but RSP
         still shows the correct TF (mirrored from left joint via the URDF mimic).
         Either way /joint_states carries "gripper_right_joint" (not _mimic) and
         MoveIt's joint-not-found spam is eliminated. -->
    <joint name="gripper_right_joint" type="prismatic">
      <origin xyz="0 -0.04 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_right_link"/>
      <axis xyz="0 -1 0"/>
      <!-- effort raised to 5 N (was 0.5) — consistent with left finger -->
      <limit lower="0.0" upper="0.04" effort="5.0" velocity="0.5"/>
      <dynamics damping="0.01" friction="0.0"/>
      <mimic joint="gripper_left_joint" multiplier="1.0" offset="0"/>
    </joint>

    <link name="gripper_right_link">
      <visual>
        <origin xyz="0.04 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <box size="0.04 0.01 0.03"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <origin xyz="0.04 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <box size="0.04 0.01 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0.04 0 0"/>
        <inertia ixx="0.0000005" ixy="0" ixz="0"
                 iyy="0.0000005" iyz="0"
                 izz="0.0000005"/>
      </inertial>
    </link>

    <!-- Gazebo properties -->
    <gazebo reference="gripper_base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="gripper_left_link">
      <material>Gazebo/DarkGrey</material>
      <!-- Reduced contact stiffness from 1e6 to 1e4 so the joint is not
           fighting a rigid contact force at rest. Friction also reduced
           so the low-gain position controller (kp=0.1 in ign_ros2_control
           Fortress) can slide the finger without stalling. -->
      <kp>10000.0</kp>
      <kd>10.0</kd>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>
    <gazebo reference="gripper_right_link">
      <material>Gazebo/DarkGrey</material>
      <kp>10000.0</kp>
      <kd>10.0</kd>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>

  </xacro:macro>

</robot>
